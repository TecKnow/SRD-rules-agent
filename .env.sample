# Copy this file to .env and fill in the values you need.
# .env is ignored by git; this sample file is safe to commit.

# Required for gathering no-RAG baseline answers and for OpenRouter-backed judging.
OPENROUTER_API_KEY=

# Optional comma-separated default models for srd-eval-gather.
# You can also pass --model more than once on the command line.
OPENROUTER_MODELS=openrouter/owl-alpha,ibm-granite/granite-4.1-8b,meta-llama/llama-4-maverick,qwen/qwen3.7-max,qwen/qwen3-max-thinking

# Optional embedding model for SRD RAG chunk and query embeddings.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional OpenRouter referer metadata.
OPENROUTER_SITE_URL=

# DeepEval grading defaults.
# Use "openrouter" to judge through OPENROUTER_API_KEY, or "deepeval" to let
# DeepEval use its native provider configuration.
DEEPEVAL_JUDGE_PROVIDER=openrouter
DEEPEVAL_JUDGE_MODEL=openai/gpt-4.1

# Required only when DEEPEVAL_JUDGE_PROVIDER=deepeval and the selected native
# DeepEval model/provider needs OpenAI credentials.
OPENAI_API_KEY=

# --- Local agent (srd_agent) ------------------------------------------------
# Defaults to a local Ollama OpenAI-compatible endpoint serving both chat and the
# nomic encoder; no edits needed for the basic local setup. Override to point at
# LM Studio, vLLM, a shared local server, or a hosted API.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# SRD_AGENT_GEN_MODEL=qwen2.5:14b-instruct
# SRD_AGENT_GEN_BACKEND=openai            # or "ollama" for native ChatOllama
# SRD_AGENT_TOP_K=6
# SRD_AGENT_FETCH_K=30
# Reranker is off unless you set a TEI reranker model + server:
# SRD_AGENT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# SRD_AGENT_TEI_RERANK_URL=http://127.0.0.1:8081
